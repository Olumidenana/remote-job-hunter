# Remote Job Hunter Environment Variables

# The email where you want to receive your daily remote job digests (Default: olumideadeyeminana@gmail.com)
JOB_ALERT_EMAIL=olumideadeyeminana@gmail.com

# Resend API key for sending live email digests directly to your inbox
# Get a free key at https://resend.com (Generous free tier: 3,000 emails/month)
RESEND_API_KEY=re_your_api_key_here

# Optional: Verified sender email in Resend (default: alerts@resend.dev or onboarding@resend.dev)
EMAIL_FROM="Olumide Job Alerts <onboarding@resend.dev>"

# Optional: Vercel Cron secret token for endpoint verification
CRON_SECRET=
